{
  "name": "@vuhoi/gat-web-profile",
  "description": "Governed Agent Team Web profile layer",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hoinv-prv/dsh-governed-agent-team.git",
    "directory": "packages/web-profile"
  },
  "type": "module",
  "main": "lib/index.js",
