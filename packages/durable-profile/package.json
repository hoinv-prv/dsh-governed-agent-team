    "@vuhoi/gat-tools": "file:../gat-tools",
    "@vuhoi/gat-durable-agent": "file:../gat-durable-agent"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "js-yaml": "^4.2.0"
  }
