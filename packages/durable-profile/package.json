{
  "name": "@vuhoi/gat-durable-profile",
  "description": "Opt-in WK Durable Agent profile layer after the GAT profile",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hoinv-prv/dsh-governed-agent-team.git",
    "directory": "packages/durable-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
