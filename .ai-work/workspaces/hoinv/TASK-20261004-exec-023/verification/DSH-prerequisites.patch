+import { afterEach, describe, expect, it } from 'vitest'
+import { mkdtempSync, mkdirSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { catalogSourceFiles } from './catalog-source-files.ts'
+
+const roots: string[] = []
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }) })
+function fixture() { const root = mkdtempSync(join(tmpdir(), 'catalog-replacement-')); roots.push(root); return root }
+function write(root: string, path: string, text = '') { const target = join(root, path); mkdirSync(dirname(target), { recursive: true }); writeFileSync(target, text) }
+const patterns = ['packages/*/*/src/**/*.ts', 'packages/*/*/src/**/*.tsx']
+
+describe('catalog selected replacement ownership', () => {
+  it('retains every default and unrelated source, including TSX', () => {
+    const root = fixture()
+    write(root, 'packages/experimental/agent-team/src/index.ts')
+    write(root, 'packages/new/contract/src/index.tsx')
+    expect(catalogSourceFiles(root, patterns)).toEqual(['packages/experimental/agent-team/src/index.ts', 'packages/new/contract/src/index.tsx'])
+  })
+  for (const [oldName, newName] of [['agent-team', 'gat-core'], ['agent-team-profile', 'gat-profile'], ['agent-team-web-profile', 'gat-web-profile'], ['client-ui-agent-team', 'gat-web'], ['tool-agent-team', 'gat-tools']]) {
+    it(`excludes only explicitly replaced ${oldName}`, () => {
+      const root = fixture(); const oldRoot = `packages/experimental/${oldName}`; const newRoot = `packages/experimental/${newName}`
+      write(root, `${oldRoot}/src/index.ts`); write(root, `${newRoot}/src/index.tsx`); write(root, `${newRoot}/tsconfig.json`, '{}')
+      write(root, 'packages/new/contract/src/index.ts')
+      write(root, 'tsconfig.host.json', JSON.stringify({ exclude: [`${oldRoot}/**`], references: [{ path: `./${newRoot}` }] }))
+      expect(catalogSourceFiles(root, patterns)).toEqual([`${newRoot}/src/index.tsx`, 'packages/new/contract/src/index.ts'])
+    })
+  }
+  it('does not narrow discovery from a directory or exclusion alone', () => {
+    const root = fixture()
+    write(root, 'packages/experimental/agent-team/src/index.ts'); write(root, 'packages/experimental/gat-core/src/index.ts')
+    write(root, 'tsconfig.host.json', JSON.stringify({ exclude: ['packages/experimental/agent-team/**'], references: [] }))
+    expect(catalogSourceFiles(root, patterns)).toHaveLength(2)
+  })
+  it('validates replacement ownership independently of a narrow caller corpus', () => {
+    const root = fixture()
+    write(root, 'packages/experimental/agent-team/src/index.ts')
+    write(root, 'packages/experimental/gat-core/src/index.ts')
+    write(root, 'packages/experimental/gat-core/tsconfig.json', '{}')
+    write(root, 'vendor/cordis/src/index.ts')
+    write(root, 'tsconfig.host.json', JSON.stringify({ exclude: ['packages/experimental/agent-team/**'], references: [{ path: './packages/experimental/gat-core' }] }))
+    expect(catalogSourceFiles(root, 'vendor/**/*.ts')).toEqual(['vendor/cordis/src/index.ts'])
+  })
+  it('keeps exhaustive tool-directory discovery while excluding the selected original', () => {
+    const root = fixture()
+    write(root, 'packages/experimental/tool-agent-team/src/index.ts')
+    write(root, 'packages/experimental/gat-tools/src/index.ts')
+    write(root, 'packages/experimental/gat-tools/tsconfig.json', '{}')
+    write(root, 'packages/new/tool-unregistered/src/index.ts')
+    write(root, 'tsconfig.host.json', JSON.stringify({ exclude: ['packages/experimental/tool-agent-team/**'], references: [{ path: './packages/experimental/gat-tools' }] }))
+    expect(catalogSourceFiles(root, 'packages/*/tool-*')).toEqual(['packages/new/tool-unregistered'])
+  })
+  it('rejects missing and contradictory replacement configurations', () => {
+    const root = fixture(); const oldRoot = 'packages/experimental/agent-team'; const newRoot = 'packages/experimental/gat-core'
+    write(root, `${oldRoot}/src/index.ts`)
+    write(root, 'tsconfig.host.json', JSON.stringify({ exclude: [`${oldRoot}/**`], references: [{ path: newRoot }] }))
+    expect(() => catalogSourceFiles(root, patterns)).toThrow('missing')
+    write(root, `${newRoot}/src/index.ts`); write(root, `${newRoot}/tsconfig.json`, '{}')
+    write(root, 'tsconfig.client.json', JSON.stringify({ references: [{ path: oldRoot }] }))
+    expect(() => catalogSourceFiles(root, patterns)).toThrow('both')
+  })
+})
diff --git a/scripts/catalog-source-files.ts b/scripts/catalog-source-files.ts
new file mode 100644
index 0000000000..1d906650bf
--- /dev/null
+++ b/scripts/catalog-source-files.ts
@@ -0,0 +1,49 @@
+/** Exhaustive catalog discovery with explicitly selected package replacements. */
+import { existsSync, globSync } from 'node:fs'
+import { resolve, sep } from 'node:path'
+import ts from 'typescript'
+
+const replacements = [
+  ['agent-team', 'gat-core'],
+  ['agent-team-profile', 'gat-profile'],
+  ['agent-team-web-profile', 'gat-web-profile'],
+  ['client-ui-agent-team', 'gat-web'],
+  ['tool-agent-team', 'gat-tools'],
+] as const
+const normalized = (path: string): string => path.split(sep).join('/').replace(/^\.\//, '')
+
+/** Discover all matching sources; retain inactive originals outside catalog ownership.
+ * @param scanRoot - repository whose build entry selects replacement packages.
+ * @param patterns - exhaustive source discovery globs.
+ * @returns sorted normalized source paths, excluding validated inactive originals only.
+ * @throws when replacement selection is incomplete or contradicts the build references.
+ */
+export function catalogSourceFiles(scanRoot: string, patterns: string | readonly string[]): string[] {
+  const files = [...new Set(globSync(patterns as string | string[], { cwd: scanRoot }).map(normalized))].sort()
+  const selected = new Set<string>()
+  const excluded = new Set<string>()
+  for (const entry of ['tsconfig.host.json', 'tsconfig.client.json']) {
+    const path = resolve(scanRoot, entry)
+    if (!existsSync(path)) continue
+    const result = ts.readConfigFile(path, file => ts.sys.readFile(file))
+    if (result.error !== undefined) throw new Error(`catalog sources: cannot read ${entry}`)
+    const config = result.config as { references?: { path: string }[]; exclude?: string[] }
+    for (const reference of config.references ?? []) selected.add(normalized(reference.path).replace(/\/tsconfig(?:\.[^/]+)?\.json$/, ''))
+    for (const pattern of config.exclude ?? []) excluded.add(normalized(pattern))
+  }
+  const inactive: string[] = []
+  for (const [original, replacement] of replacements) {
+    const oldRoot = `packages/experimental/${original}`
+    const newRoot = `packages/experimental/${replacement}`
+    if (!excluded.has(`${oldRoot}/**`) || !selected.has(newRoot)) continue
+    if (selected.has(oldRoot)) throw new Error(`catalog sources: both ${original} and its replacement are selected`)
+    if (!existsSync(resolve(scanRoot, newRoot, 'tsconfig.json'))
+      || globSync(`${newRoot}/src/**/*.{ts,tsx}`, { cwd: scanRoot }).length === 0) {
+      throw new Error(`catalog sources: selected replacement ${replacement} is missing`)
+    }
+    inactive.push(`${oldRoot}/`)
+  }
+  const result = files.filter(path => !inactive.some(prefix => path === prefix.slice(0, -1) || path.startsWith(prefix)))
+  if (files.length > 0 && result.length === 0) throw new Error('catalog sources: replacement selection emptied the corpus')
+  return result
+}
