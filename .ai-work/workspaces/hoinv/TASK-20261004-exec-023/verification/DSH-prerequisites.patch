+import { AsyncLocalStorage } from 'node:async_hooks'
+import { createHash, randomUUID } from 'node:crypto'
+
+interface Admission {
+  readonly id: string
+  readonly endpoint: string
+  readonly wireDigest: string
+  readonly signal: AbortSignal
+  active: boolean
+  consumed: boolean
+  resolved?: readonly unknown[]
+  requestDigest?: string
+}
+const admissions = new AsyncLocalStorage<Admission>()
+
+/** Digest JSON using sorted object keys; wire values have already passed JSON parsing. */
+function digest(value: unknown): string {
+  return createHash('sha256').update(JSON.stringify(value, (_key, item: unknown) => {
+    if (item && typeof item === 'object' && !Array.isArray(item)) {
+      return Object.fromEntries(Object.entries(item).sort(([a], [b]) => a.localeCompare(b)))
+    }
+    return item
+  }) ?? 'undefined').digest('hex')
+}
+
+/** Carrier-internal entry; called only after actual browser request authentication. */
+async function authenticatedControl<T>(endpoint: string, payload: unknown, signal: AbortSignal, run: () => Promise<T>): Promise<T> {
+  const admission: Admission = { id: randomUUID(), endpoint, wireDigest: digest(payload), signal, active: true, consumed: false }
+  return admissions.run(admission, async () => {
+    try { return await run() } finally { admission.active = false }
+  })
+}
+
+/**
+ * Bind authenticated wire arguments to one Gateway-resolved unary invocation.
+ * @param endpoint - exact registered action.
+ * @param args - exact decoded wire arguments.
+ * @param resolved - Gateway-resolved positional arguments.
+ * @param run - invocation retaining this request lifetime.
+ * @returns the business result; unverified calls retain no admission.
+ */
+export async function withControlInvocation<T>(endpoint: string, args: Readonly<Record<string, unknown>>, resolved: readonly unknown[], run: () => Promise<T>): Promise<T> {
+  const admission = admissions.getStore()
+  if (admission?.active && !admission.signal.aborted && admission.endpoint === endpoint && admission.wireDigest === digest({ args }) && admission.resolved === undefined) {
+    admission.resolved = Object.freeze([...resolved])
+    admission.requestDigest = digest(resolved[1] === admission.signal ? undefined : resolved[1])
+    return await run()
+  }
+  return await admissions.run(undefined as unknown as Admission, run)
+}
+
+/** Receipt fields safe to retain in a durable protected authorization event. */
+export interface HumanControlReceipt {
+  readonly id: string
+  readonly digest: string
+  readonly action: string
+  readonly sessionId: string
+}
+
+/**
+ * Consume one exact authenticated control action; possession cannot be supplied through JSON.
+ * @param action - exact Remote endpoint.
+ * @param caller - exact Gateway-resolved Agent identity.
+ * @param request - revision-bound request decoded by Gateway.
+ * @returns safe receipt evidence, or throws before any protected effect.
+ */
+export function consumeHumanControl(action: string, caller: { readonly id: string }, request: unknown): HumanControlReceipt {
+  const admission = admissions.getStore()
+  const resolved = admission?.resolved
+  if (!admission?.active || admission.consumed || admission.signal.aborted || admission.endpoint !== action || resolved?.[0] !== caller || admission.requestDigest !== digest(request)) {
+    throw new Error('HUMAN_CONTROL_REQUIRED: exact authenticated action/session/revision receipt required')
+  }
+  admission.consumed = true
+  return Object.freeze({ id: admission.id, action, sessionId: caller.id, digest: digest({ action, sessionId: caller.id, request }) })
+}
