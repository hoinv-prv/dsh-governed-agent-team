@@ -0,0 +1,250 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { CodeRuntime } from '@deepseek-ai/dsh-code-runtime'
+import type { CodeRunRequest, CodeRunResult } from '@deepseek-ai/dsh-code-runtime'
+import ToolRuntime, { defineTool, EXTERNAL_DELEGATION, TOOL_RUNTIME_SCHEDULER } from '@deepseek-ai/dsh-tools'
+import type { ToolDefinition, ToolExecution, ToolExecutionInput, ToolExecutionResult, ToolExecutionToken } from '@deepseek-ai/dsh-tools'
+
+const signal = new AbortController().signal
+
+async function setup(mode: 'native' | 'ptc' = 'native') {
+  const ctx = new Context()
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime, { mode })
+  return ctx
+}
+
+function tool(name: string, fields: Partial<ToolDefinition> = {}): ToolDefinition {
+  return { ...defineTool({
+    name, description: name, parameters: {},
+    output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+    execute: async () => 'ok',
+  }), ...fields }
+}
+
+function input(name: string, fields: Partial<ToolExecutionInput> = {}): ToolExecutionInput {
+  return { callId: ToolCallId(name), name, arguments: {}, signal, ...fields }
+}
+
+function denyDelegation(ctx: Context) {
+  return ctx.tools.guard(exec => exec.capabilities.includes(EXTERNAL_DELEGATION) ? 'Team delegation denied' : undefined)
+}
+
+class BindingRuntime extends CodeRuntime {
+  readonly language = 'typescript'
+  readonly isolation = 'test'
+  run(request: CodeRunRequest): Promise<CodeRunResult> {
+    return request.bindings[0]!.functions.inspect!({}).then(() =>
+      request.bindings[0]!.functions.alias!({}),
+    ).then(() => ({ logs: [] }))
+  }
+}
+
+describe('registry-owned capabilities', () => {
+  it('captures mutable metadata and preserves reserved classification through changed-name aliases', async () => {
+    const ctx = await setup()
+    let effects = 0
+    const capabilities = [EXTERNAL_DELEGATION]
+    const definition = tool('delegate', { capabilities, execute: async () => { effects += 1; return 'created child' } })
+    ctx.tools.register(definition)
+    capabilities.splice(0)
+    Reflect.set(definition, 'capabilities', [])
+    ctx.tools.register({ ...definition, name: 'alias', capabilities: [] })
+    ctx.tools.register({ ...ctx.tools.get('delegate')!, name: 'second_alias', capabilities: [] })
+    denyDelegation(ctx)
+    let policies = 0
+    ctx.on('tools/pre-execute', (_exec, next) => { policies += 1; return next() })
+    for (const name of ['delegate', 'alias', 'second_alias']) {
+      const result = await ctx.tools.execute(input(name))
+      expect(result.isError).toBe(true)
+      expect(result.error?.message).toBe('Team delegation denied')
+    }
+    expect({ effects, policies }).toEqual({ effects: 0, policies: 0 })
+    expect(Object.isFrozen(ctx.tools.get('alias')!.capabilities)).toBe(true)
+    expect(Reflect.set(ctx.tools.get('alias')!, 'capabilities', [])).toBe(false)
+    expect(ctx.tools.schemas().every(schema => !('capabilities' in schema))).toBe(true)
+  })
+
+  it('unions declared wrapper and descendant capabilities before wrapper effects', async () => {
+    const ctx = await setup()
+    let effects = 0
+    ctx.tools.register(tool('delegate', { capabilities: [EXTERNAL_DELEGATION] }))
+    const nestedTools = ['delegate']
+    ctx.tools.register(tool('wrapper', { capabilities: ['inspection'], nestedTools, execute: async () => { effects += 1; return 'wrapper' } }))
+    nestedTools.splice(0)
+    ctx.tools.register({ ...ctx.tools.get('wrapper')!, name: 'wrapper_alias', capabilities: [], nestedTools: [] })
+    denyDelegation(ctx)
+    for (const name of ['wrapper', 'wrapper_alias']) expect((await ctx.tools.execute(input(name))).isError).toBe(true)
+    expect(effects).toBe(0)
+  })
+
+  it.each(['missing', 'cycle'] as const)('fails closed on %s required descendants before policy and body', async (kind) => {
+    const ctx = await setup()
+    let effects = 0
+    ctx.tools.register(tool('wrapper', { nestedTools: [kind === 'missing' ? 'unregistered' : 'wrapper'], execute: async () => { effects += 1; return 'wrapper' } }))
+    ctx.on('tools/pre-execute', (_exec, next) => { effects += 1; return next() })
+    expect((await ctx.tools.execute(input('wrapper'))).isError).toBe(true)
+    expect(effects).toBe(0)
+  })
+
+  it('fails closed on missing required classification and ordinary transport spoofing', async () => {
+    const ctx = await setup()
+    let effects = 0
+    ctx.tools.register(tool('unknown', { async execute() { effects += 1; return 'effect' } }))
+    ctx.tools.register(tool('inspection_wrapper', { capabilities: ['team-inspection'], nestedTools: ['unknown'] }))
+    const result = await ctx.tools.execute(input('inspection_wrapper'))
+    expect(result.error?.info?.code).toBe('INVALID_TOOL_CAPABILITIES')
+    expect(effects).toBe(0)
+    expect(() => ctx.tools.register(tool('fake_transport', { capabilities: ['nested-dispatch'] }))).toThrow('reserved')
+  })
+
+  it('keeps dynamic effectful descendants outside a read-only parent exemption', async () => {
+    const ctx = await setup()
+    let effects = 0
+    ctx.tools.register(tool('unknown', { async execute() { effects += 1; return 'effect' } }))
+    ctx.tools.register(tool('inspect_parent', { capabilities: ['team-inspection'], async execute() {
+      const result = await ctx.tools.execute(input('unknown'))
+      return result.isError ? result.error.message : 'unclassified effect'
+    } }))
+    ctx.tools.guard(exec => exec.capabilities.every(key => key === 'team-inspection') ? undefined : 'execution lease required')
+    const result = await ctx.tools.execute(input('inspect_parent'))
+    expect(result.isError ? undefined : result.value).toBe('execution lease required')
+    expect(effects).toBe(0)
+  })
+
+  it('keeps disabled policy behavior and effect registration disposal compatible', async () => {
+    const ctx = await setup()
+    ctx.tools.register(tool('delegate', { capabilities: [EXTERNAL_DELEGATION] }))
+    const lift = denyDelegation(ctx)
+    expect((await ctx.tools.execute(input('delegate'))).isError).toBe(true)
+    lift()
+    expect((await ctx.tools.execute(input('delegate'))).isError).toBe(false)
+    const dispose = ctx.tools.register(tool('wrapper', { nestedTools: ['delegate'] }))
+    dispose()
+    expect(ctx.tools.get('wrapper')).toBeUndefined()
+  })
+
+  it('rechecks a disposed required dependency and registration replacement after asynchronous admission', async () => {
+    const ctx = await setup()
+    let bodies = 0
+    const dispose = ctx.tools.register(tool('dependency'))
+    ctx.tools.register(tool('wrapper', { nestedTools: ['dependency'], execute: async () => { bodies += 1; return 'ok' } }))
+    ctx.on('tools/pre-execute', async (_exec, next) => { await Promise.resolve(); dispose(); return next() })
+    expect((await ctx.tools.execute(input('wrapper'))).isError).toBe(true)
+    expect(bodies).toBe(0)
+  })
+
+  it('inherits the exact asynchronous parent union without caller-supplied nesting fields', async () => {
+    const ctx = await setup()
+    const seen: ToolExecution[] = []
+    let parent!: ToolExecutionToken
+    ctx.tools.register(tool('child', { capabilities: ['inspection'] }))
+    ctx.tools.register(tool('parent', {
+      capabilities: ['parent-effect'],
+      async execute(_args, exec) {
+        parent = exec.token
+        await Promise.resolve()
+        const nested = await ctx.tools.execute(input('child', { callId: ToolCallId('child-call') }))
+        return nested.isError ? 'failed' : nested.value
+      },
+    }))
+    ctx.tools.guard((exec) => { seen.push(exec); return undefined })
+    const result = await ctx.tools.execute(input('parent', { callId: ToolCallId('root') }))
+    expect(result.isError).toBe(false)
+    const child = seen.find(exec => exec.name === 'child')!
+    expect(child.parent).toBe(parent)
+    expect(child.rootCallId).toBe(ToolCallId('root'))
+    expect(child.capabilities).toEqual(['inspection', 'parent-effect'])
+    expect(Object.isFrozen(child.capabilities)).toBe(true)
+  })
+
+  it('denies actual dynamic nested delegation before its policy, wrapper and body effects', async () => {
+    const ctx = await setup()
+    let childEffects = 0
+    ctx.tools.register(tool('delegate', { capabilities: [EXTERNAL_DELEGATION], execute: async () => { childEffects += 1; return 'child' } }))
+    ctx.tools.register(tool('inspect', { async execute() {
+      await Promise.resolve()
+      const nested = await ctx.tools.execute(input('delegate'))
+      return nested.isError ? nested.error.message : 'unexpected child'
+    } }))
+    ctx.on('tools/pre-execute', (exec, next) => { if (exec.name === 'delegate') childEffects += 1; return next() })
+    ctx.on('tools/execute', (exec, next) => { if (exec.name === 'delegate') childEffects += 1; return next() })
+    denyDelegation(ctx)
+    const result = await ctx.tools.execute(input('inspect'))
+    expect(result.isError ? undefined : result.value).toBe('Team delegation denied')
+    expect(childEffects).toBe(0)
+  })
+
+  it('cannot strip classification or replace caller identity through an around-dispatch wrapper', async () => {
+    const ctx = await setup()
+    let enabled = false
+    let bodies = 0
+    ctx.tools.register(tool('delegate', { capabilities: [EXTERNAL_DELEGATION], execute: async () => { bodies += 1; return 'child' } }))
+    ctx.tools.guard(exec => enabled && exec.capabilities.includes(EXTERNAL_DELEGATION) ? 'Team delegation denied' : undefined)
+    ctx.on('tools/execute', (exec, next) => {
+      enabled = true
+      for (const [key, value] of [['capabilities', []], ['name', 'inspect'], ['parent', undefined], ['agent', {}], ['arguments', {}]]) {
+        expect(Reflect.set(exec, key as string, value)).toBe(false)
+      }
+      return next()
+    })
+    expect((await ctx.tools.execute(input('delegate'))).isError).toBe(true)
+    expect(bodies).toBe(0)
+  })
+
+  it('denies forged, expired and cross-Agent parent identities', async () => {
+    const ctx = await setup()
+    let token!: ToolExecutionToken
+    let nested: ToolExecutionResult | undefined
+    const owner = {} as Agent
+    const other = {} as Agent
+    ctx.tools.register(tool('child'))
+    ctx.tools.register(tool('parent', { async execute(_args, exec) {
+      token = exec.token
+      nested = await ctx.tools.execute(input('child', { parent: exec.token, agent: other }))
+      return 'parent'
+    } }))
+    expect((await ctx.tools.execute(input('child', { parent: Symbol('forged') as ToolExecutionToken }))).error?.info?.code).toBe('INVALID_TOOL_PARENT')
+    await ctx.tools.execute(input('parent', { agent: owner }))
+    expect(nested?.error?.info?.code).toBe('INVALID_TOOL_PARENT')
+    expect((await ctx.tools.execute(input('child', { parent: token, agent: owner }))).error?.info?.code).toBe('INVALID_TOOL_PARENT')
+  })
+
+  it('revalidates queued scheduler calls before around-dispatch effects', async () => {
+    const ctx = await setup()
+    let enabled = false
+    let effects = 0
+    ctx.tools.register(tool('delegate', { capabilities: [EXTERNAL_DELEGATION] }))
+    ctx.tools.guard(exec => enabled && exec.capabilities.includes(EXTERNAL_DELEGATION) ? 'Team delegation denied' : undefined)
+    ctx.on('tools/execute', (_exec, next) => { effects += 1; return next() })
+    const prepared = await ctx.tools[TOOL_RUNTIME_SCHEDULER].prepare(input('delegate'))
+    expect(prepared.kind).toBe('dispatch')
+    if (prepared.kind !== 'dispatch') return
+    enabled = true
+    const outcome = await ctx.tools[TOOL_RUNTIME_SCHEDULER].dispatch(prepared.exec)
+    ctx.tools[TOOL_RUNTIME_SCHEDULER].finish(prepared.exec, outcome.result)
+    expect(outcome.result.isError).toBe(true)
+    expect(effects).toBe(0)
+  })
+
+  it('allows actual PTC inspection but denies the invoked delegation alias before nested event effects', async () => {
+    const ctx = await setup('ptc')
+    await ctx.plugin(BindingRuntime)
+    let delegated = 0
+    let inspected = 0
+    const events: { type: string; data: unknown }[] = []
+    const agent = { session: { append: (type: string, data: unknown) => { events.push({ type, data }) } } } as unknown as Agent
+    ctx.tools.register(tool('inspect', { async execute() { inspected += 1; return 'view' } }))
+    const definition = tool('delegate', { capabilities: [EXTERNAL_DELEGATION], async execute() { delegated += 1; return 'child' } })
+    ctx.tools.register(definition)
+    ctx.tools.register({ ...definition, name: 'alias', capabilities: [] })
+    denyDelegation(ctx)
+    const result = await ctx.tools.execute(input('run_code', { agent, arguments: { code: 'bindings invoked by runtime', description: 'Inspect then delegate' } }))
+    expect(result.isError).toBe(true)
+    expect({ delegated, inspected }).toEqual({ delegated: 0, inspected: 1 })
+    expect(events.map(event => (event.data as { name: string }).name)).toEqual(['inspect', 'inspect'])
+  })
+})
