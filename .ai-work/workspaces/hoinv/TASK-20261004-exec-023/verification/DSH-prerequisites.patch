diff --git a/packages/subagent/subagent/tests/reserved.spec.ts b/packages/subagent/subagent/tests/reserved.spec.ts
new file mode 100644
index 0000000000..15e013f308
--- /dev/null
+++ b/packages/subagent/subagent/tests/reserved.spec.ts
@@ -0,0 +1,301 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionEventMap } from '@deepseek-ai/dsh-session'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import * as Spawn from '@deepseek-ai/dsh-subagent-spawn-in-process'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import Subagents from '../src/index.ts'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { TestSessionQuery } from './test-session-query.ts'
+import { loadStoredSession } from './persistence-helpers.ts'
+import { foldInitialAdmission } from '../src/reserved.ts'
+import { continuationActivations } from './continuation-internals.ts'
+
+const cleanups: (() => Promise<void>)[] = []
+afterEach(async () => { for (const cleanup of cleanups.splice(0)) await cleanup() })
+const signal = new AbortController().signal
+const content = (text: string) => [{ type: 'text' as const, text }]
+
+async function harness() {
+  const ctx = new Context()
+  const root = mkdtempSync(join(tmpdir(), 'dsh-reserved-'))
+  cleanups.push(async () => { await ctx.fiber.dispose(); rmSync(root, { recursive: true, force: true }) })
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(JsonlSessionPersistence, { root })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(TestSessionQuery)
+  await ctx.plugin(Subagents)
+  await ctx.plugin(Spawn, { providerName: 'spawn' })
+  const adapter = new MockAdapter(Array.from({ length: 12 }, () => textResponse('done')))
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const parent = await ctx.agentLoop.create(SessionId('reserved-parent'), { provider: 'mock', model: 'mock' })
+  const materialize = () => ctx.subagents.materializeContinuable({
+    provider: 'spawn', label: 'reserved', request: { parent }, signal,
+  })
+  return { ctx, parent, adapter, materialize }
+}
+
+describe('reserved continuable owner admission', () => {
+  it('quarantines durable initial input, deduplicates and activates once under concurrent calls', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    expect(r.memberScope).toBe(r.agent.ctx)
+    expect(r.state).toBe('materialized')
+    expect(r.agent.inbox.nextTurn).toEqual([])
+    expect(h.adapter.requests).toEqual([])
+    await expect(r.activate(signal)).rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+    const ids = await Promise.all([r.persistInitialPrompt(content('go'), 'one', signal), r.persistInitialPrompt(content('go'), 'one', signal)])
+    expect(ids[0]).toBe(ids[1])
+    expect(r.state).toBe('inbox-persisted')
+    expect(r.agent.inbox.nextTurn).toEqual([])
+    const stored = await loadStoredSession(h.ctx.sessionPersistence, r.childId)
+    expect(stored.events.filter(e => e.type === 'subagent/initial-admission')).toHaveLength(1)
+    expect(stored.events.some(e => e.type === 'user/message')).toBe(false)
+    await expect(r.persistInitialPrompt(content('changed'), 'one', signal)).rejects.toMatchObject({ code: 'CONTINUABLE_ADMISSION_CONFLICT' })
+    await Promise.all([r.activate(signal), r.activate(signal)])
+    await r.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+    const released = await loadStoredSession(h.ctx.sessionPersistence, r.childId)
+    expect(released.events.filter(e => e.type === 'subagent/initial-admission' && e.data.kind === 'activated')).toHaveLength(1)
+    expect(released.events.filter(e => e.type === 'user/message' && e.data.id === ids[0])).toHaveLength(1)
+  })
+
+  it('blocks direct wakes and legacy recovery until the owner opens the exact generation', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    r.agent.followup(createUserMessage({ content: content('queued directly'), source: { kind: 'user' } }))
+    r.agent.steer(createUserMessage({ content: content('steered directly'), source: { kind: 'user' } }))
+    await r.agent.whenIdle()
+    expect(h.adapter.requests).toEqual([])
+    await expect(h.ctx.subagents.sendMessage(h.parent, r.childId, content('bypass'), { signal })).rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+    await r.persistInitialPrompt(content('initial'), 'init', signal)
+    await r.dispose()
+    await expect(h.ctx.agents.resume({ resumeSessionId: r.childId })).rejects.toThrow('CONTINUABLE_STATE_CONFLICT')
+    await expect(h.ctx.subagents.sendMessage(h.parent, r.childId, content('cold bypass'), { signal })).rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+    const recovered = await h.ctx.subagents.recoverContinuable({ childId: r.childId, parent: h.parent, provider: 'spawn', signal })
+    expect(recovered.agent).not.toBe(r.agent)
+    expect(recovered.state).toBe('inbox-persisted')
+    expect(h.adapter.requests).toEqual([])
+    await recovered.activate(signal)
+    await recovered.agent.whenIdle()
+    expect(h.adapter.requests.some(request => request.sessionId === r.childId)).toBe(true)
+  })
+
+  it('flushes cancellation before disposal and rejects tombstoned recovery', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    await r.persistInitialPrompt(content('must not execute'), 'init', signal)
+    await r.abort(signal)
+    const stored = await loadStoredSession(h.ctx.sessionPersistence, r.childId)
+    expect(stored.events.at(-1)?.type).toBe('subagent/initial-admission')
+    expect(stored.events.at(-1)?.data).toEqual({ version: 1, kind: 'aborted' })
+    expect(h.adapter.requests).toEqual([])
+    await expect(r.activate(signal)).rejects.toMatchObject({ code: 'CONTINUABLE_CLOSED' })
+    await expect(h.ctx.subagents.recoverContinuable({ childId: r.childId, parent: h.parent, signal })).rejects.toMatchObject({ code: 'CONTINUABLE_CLOSED' })
+  })
+
+  it('recovers activated history behind a fresh gate without duplicating consumed initial input', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    await r.persistInitialPrompt(content('once'), 'init', signal)
+    await r.activate(signal)
+    await r.agent.whenIdle()
+    await vi.waitFor(() => { expect(h.ctx.agents.get(r.childId)).toBeUndefined() })
+    const recovered = await h.ctx.subagents.recoverContinuable({ childId: r.childId, parent: h.parent, signal })
+    recovered.agent.followup(createUserMessage({ content: content('later'), source: { kind: 'user' } }))
+    await recovered.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+    await recovered.activate(signal)
+    await recovered.agent.whenIdle()
+    const requests = h.adapter.requests.filter(request => request.sessionId === r.childId)
+    expect(requests).toHaveLength(2)
+    expect(requests[1]!.messages.filter(message => message.role === 'user' && message.content.some(block => block.type === 'text' && block.text === 'once'))).toHaveLength(1)
+  })
+
+  it('fails closed on persistence error, then permits owner retry of the same durable item', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    const failure = h.ctx.on('session/flush', async () => { throw new Error('storage unavailable') })
+    await expect(r.persistInitialPrompt(content('go'), 'init', signal)).rejects.toMatchObject({ code: 'CONTINUABLE_PERSIST_FAILED' })
+    expect(h.adapter.requests).toEqual([])
+    failure()
+    const id = await r.persistInitialPrompt(content('go'), 'init', signal)
+    expect(id).toBe(r.initialMessageId)
+    await r.activate(signal)
+    await r.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+  })
+  it('recovers a released initial item claimed before a failed first model admission', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    r.memberScope.on('agent/prepare-prompt', async ({ signal: turnSignal }) => {
+      entered.resolve(undefined)
+      await release.promise
+      turnSignal.throwIfAborted()
+    })
+    const id = await r.persistInitialPrompt(content('recover pre-admission claim'), 'init', signal)
+    await r.activate(signal)
+    await entered.promise
+    const closing = r.dispose()
+    release.resolve(undefined)
+    await closing
+    expect(h.adapter.requests).toEqual([])
+    const recovered = await h.ctx.subagents.recoverContinuable({ childId: r.childId, parent: h.parent, signal })
+    expect(recovered.initialMessageId).toBe(id)
+    await recovered.activate(signal)
+    await recovered.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+    expect(recovered.agent.session.snapshotEvents().filter(e => e.type === 'user/message' && e.data.id === id)).toHaveLength(1)
+  })
+
+  it('keeps durable activation unavailable on flush failure and retries release without another initial item', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    await r.persistInitialPrompt(content('once'), 'init', signal)
+    const failure = h.ctx.on('session/flush', async () => { throw new Error('activation flush failed') })
+    await expect(r.activate(signal)).rejects.toMatchObject({ code: 'CONTINUABLE_ACTIVATE_FAILED' })
+    expect(h.adapter.requests).toEqual([])
+    failure()
+    await r.activate(signal)
+    await r.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+    expect(r.agent.session.snapshotEvents().filter(e => e.type === 'subagent/initial-admission' && e.data.kind === 'persisted')).toHaveLength(1)
+    expect(r.agent.session.snapshotEvents().filter(e => e.type === 'subagent/initial-admission' && e.data.kind === 'activated')).toHaveLength(1)
+  })
+
+  it('rejects canceled persistence and mismatched recovered descriptor before dispatch', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    const canceled = new AbortController()
+    canceled.abort(new Error('canceled'))
+    await expect(r.persistInitialPrompt(content('unused'), 'init', canceled.signal)).rejects.toThrow('canceled')
+    expect(r.initialMessageId).toBeUndefined()
+    await r.persistInitialPrompt(content('go'), 'init', signal)
+    await r.dispose()
+    await expect(h.ctx.subagents.recoverContinuable({ childId: r.childId, parent: h.parent, provider: 'fork', signal })).rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+    expect(h.adapter.requests).toEqual([])
+  })
+
+  it('closes admission at abort deadline and observes late tombstone cleanup', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    await r.persistInitialPrompt(content('never dispatched'), 'init', signal)
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    const listener = h.ctx.on('session/flush', async (session) => {
+      if (session.id !== r.childId) return
+      entered.resolve(undefined)
+      await release.promise
+    })
+    const deadline = new AbortController()
+    const aborting = r.abort(deadline.signal)
+    await entered.promise
+    deadline.abort(new Error('cleanup deadline'))
+    await expect(aborting).rejects.toThrow('cleanup deadline')
+    const activation = r.activate(signal)
+    r.agent.followup(createUserMessage({ content: content('bypass late cleanup'), source: { kind: 'user' } }))
+    expect(h.adapter.requests).toEqual([])
+    release.resolve(undefined)
+    listener()
+    await expect(activation).rejects.toMatchObject({ code: 'CONTINUABLE_CLOSED' })
+    await vi.waitFor(() => { expect(h.ctx.agents.get(r.childId)).toBeUndefined() })
+    const stored = await loadStoredSession(h.ctx.sessionPersistence, r.childId)
+    expect(stored.events.some(e => e.type === 'subagent/initial-admission' && e.data.kind === 'aborted')).toBe(true)
+    expect(h.adapter.requests).toEqual([])
+  })
+
+  it.each([null, undefined, [], 17, 'record'])('rejects malformed durable admission payload %j with the stable conflict', (data) => {
+    const event = { type: 'subagent/initial-admission', data } as unknown as SessionEvent
+    expect(() => foldInitialAdmission([event])).toThrow(expect.objectContaining({ code: 'CONTINUABLE_STATE_CONFLICT' }))
+  })
+
+  it('shares disposal rejection across concurrent and later callers', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    const activation = continuationActivations(h.ctx).get(r.childId)!
+    const cleanup = activation.handle.dispose.bind(activation.handle)
+    const injected = new Error('cleanup failed after drain')
+    const spy = vi.spyOn(activation.handle, 'dispose').mockImplementation(async () => {
+      await cleanup()
+      throw injected
+    })
+    const first = r.dispose()
+    const concurrent = r.dispose()
+    expect(concurrent).toBe(first)
+    const results = await Promise.allSettled([first, concurrent])
+    expect(results[0].status).toBe('rejected')
+    if (results[0].status !== 'rejected') throw new Error('disposal unexpectedly succeeded')
+    await expect(r.dispose()).rejects.toBe(results[0].reason)
+    expect(results[1]).toEqual(results[0])
+    expect(spy).toHaveBeenCalledTimes(1)
+    expect(h.adapter.requests).toEqual([])
+  })
+
+  it('rechecks synchronous activation authority after a blocked durable flush before waking', async () => {
+    const h = await harness()
+    const r = await h.materialize()
+    await r.persistInitialPrompt(content('guarded initial'), 'init', signal)
+    let allowed = true
+    r.memberScope.agents.guardExecution(r.agent, ({ kind }) => {
+      if (kind === 'activation' && !allowed) throw new Error('activation authority revoked')
+      return undefined
+    })
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    const listener = h.ctx.on('session/flush', async (session) => {
+      if (session.id !== r.childId) return
+      entered.resolve(undefined)
+      await release.promise
+    })
+    const running: string[] = []
+    h.ctx.on('agent/status', ({ agent, status }) => { if (agent === r.agent) running.push(status) })
+    const activating = r.activate(signal)
+    await entered.promise
+    allowed = false
+    release.resolve(undefined)
+    await expect(activating).rejects.toMatchObject({ code: 'CONTINUABLE_ACTIVATE_FAILED' })
+    expect(r.agent.status).toBe('idle')
+    expect(running).not.toContain('running')
+    expect(h.adapter.requests).toEqual([])
+    listener()
+    allowed = true
+    await r.activate(signal)
+    await r.agent.whenIdle()
+    expect(h.adapter.requests.filter(request => request.sessionId === r.childId)).toHaveLength(1)
+  })
+
+  it.each([null, [], 17, 'record', { version: 1, owner: 'subagent', recovery: 'unknown' }])(
+    'denies corrupt reservation %j at generic resume and owner recovery before effects', async (data) => {
+      const h = await harness()
+      const childId = SessionId('corrupt-reservation')
+      const handle = await h.ctx.agents.create({
+        sessionId: childId,
+        parentAgent: h.parent,
+        meta: { parentSession: h.parent.id, origin: 'subagent' },
+        agentOptions: { provider: 'mock', model: 'mock' },
+        setup: (_ctx, child) => {
+          child.session.append('subagent/descriptor', { version: 3, mode: 'continuable', provider: 'spawn', label: 'corrupt' })
+          child.session.append('agent/execution-reserved', data as unknown as SessionEventMap['agent/execution-reserved'])
+        },
+      })
+      await h.ctx.sessions.flush(handle.agent.session)
+      await handle.dispose()
+      await expect(h.ctx.agents.resume({ resumeSessionId: childId })).rejects.toThrow('CONTINUABLE_STATE_CONFLICT')
+      await expect(h.ctx.subagents.sendMessage(h.parent, childId, content('cannot bypass owner'), { signal }))
+        .rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+      await expect(h.ctx.subagents.recoverContinuable({ childId, parent: h.parent, signal }))
+        .rejects.toMatchObject({ code: 'CONTINUABLE_STATE_CONFLICT' })
+      expect(h.adapter.requests).toEqual([])
+      expect(h.ctx.agents.get(childId)).toBeUndefined()
+    },
+  )
+
+})
