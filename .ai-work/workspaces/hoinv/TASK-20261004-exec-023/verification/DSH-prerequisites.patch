@@ -0,0 +1,218 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createUserMessage, LlmError, ToolCallId } from '@deepseek-ai/dsh-llm'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import type { ToolExecution } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { for (const ctx of contexts.splice(0)) await ctx.fiber.dispose() })
+async function harness(script: ConstructorParameters<typeof MockAdapter>[0] = [textResponse('done')]) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const adapter = new MockAdapter(script)
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const handle = await ctx.agents.create({ sessionId: SessionId('refresh'), agentOptions: { provider: 'mock', model: 'mock' } })
+  return { ctx, adapter, handle, agent: handle.agent }
+}
+function send(agent: Awaited<ReturnType<typeof harness>>['agent']) {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
+  return agent.whenIdle()
+}
+
+describe('owner prompt preparation and final model admission', () => {
+  it('detaches independent exact Agent drivers and restores ordinary nested admission', async () => {
+    const h = await harness()
+    const second = await h.ctx.agents.create({ sessionId: SessionId('independent'), agentOptions: { provider: 'mock', model: 'mock' } })
+    let callbackEffects = 0
+    const stale = { ...second.agent }
+    expect(() => { h.ctx.tools.withAgentDriver(stale, () => { callbackEffects += 1 }) }).toThrow('exact live Agent')
+    expect(callbackEffects).toBe(0)
+    const observations: ToolExecution[] = []
+    h.ctx.tools.guard((exec) => { if (exec.name === 'independent-inspect') observations.push(exec); return undefined })
+    h.ctx.tools.register(defineTool({ name: 'independent-inspect', description: 'inspect', parameters: {}, capabilities: ['inspection'],
+      output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] }, execute: async () => 'ok' }))
+    const signal = new AbortController().signal
+    const inspect = (agent: typeof h.agent, id: string) => h.ctx.tools.execute({ name: 'independent-inspect', arguments: {}, agent, signal, callId: ToolCallId(id) })
+    h.ctx.tools.register(defineTool({ name: 'parent-context', description: 'parent', parameters: {}, capabilities: ['parent-effect'],
+      output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+      async execute() {
+        const independent = await h.ctx.tools.withAgentDriver(second.agent, async () => { await Promise.resolve(); return inspect(second.agent, 'independent-root') })
+        expect(independent.isError).toBe(false)
+        const crossAgent = await inspect(second.agent, 'wrong-nested-agent')
+        expect(crossAgent.isError).toBe(true)
+        if (crossAgent.isError) expect(crossAgent.error.info?.code).toBe('INVALID_TOOL_PARENT')
+        expect((await inspect(h.agent, 'ordinary-nested')).isError).toBe(false)
+        return 'ok'
+      } }))
+    expect((await h.ctx.tools.execute({ name: 'parent-context', arguments: {}, agent: h.agent, signal, callId: ToolCallId('parent-root') })).isError).toBe(false)
+    const independent = observations.find(exec => exec.callId === ToolCallId('independent-root'))!
+    expect(independent.parent).toBeUndefined()
+    expect(independent.capabilities).toEqual(['inspection'])
+    const nested = observations.find(exec => exec.callId === ToolCallId('ordinary-nested'))!
+    expect(nested.parent).toBeDefined()
+    expect(nested.capabilities).toEqual(['inspection', 'parent-effect'])
+    expect(h.adapter.requests).toHaveLength(0)
+    await second.dispose()
+    expect(() => { h.ctx.tools.withAgentDriver(second.agent, () => { callbackEffects += 1 }) }).toThrow('exact live Agent')
+    expect(callbackEffects).toBe(0)
+  })
+
+  it('awaits refreshed scoped sections and contexts on retries, preserving unrelated owners and replay', async () => {
+    const h = await harness()
+    const failure = () => { throw new LlmError('retry', 'TEMPORARY') }
+    const adapter = new MockAdapter([failure, textResponse('done')])
+    h.ctx.llm.registerAdapter(['retry'], adapter)
+    h.agent.options.provider = 'retry'
+    h.ctx.systemPrompt.section({ name: 'other-owner', order: 400, text: 'other owner retained' })
+    let removeSection: (() => void) | undefined
+    let removeContext: (() => void) | undefined
+    const attempts: number[] = []
+    h.agent.ctx.on('agent/prepare-prompt', async ({ attempt }) => {
+      await Promise.resolve(undefined)
+      attempts.push(attempt)
+      removeSection?.()
+      removeContext?.()
+      removeSection = h.agent.ctx.systemPrompt.section({ name: 'binder', order: 300, text: `binding revision ${attempt}` })
+      removeContext = h.agent.ctx.systemPrompt.context({ name: 'binder-context', order: 300, text: `memory revision ${attempt}` })
+    })
+    h.agent.ctx.on('agent/request-error', async () => ({ kind: 'retry' }))
+    h.ctx.on('llm/stream', (request, next) => {
+      expect(request.messages).toEqual(Session.create(h.agent.id, h.agent.session.snapshotEvents()).deriveMessages())
+      return next()
+    })
+    await send(h.agent)
+    expect(attempts).toEqual([1, 2])
+    expect(adapter.requests).toHaveLength(2)
+    const first = JSON.stringify(adapter.requests[0]!.messages)
+    const second = JSON.stringify(adapter.requests[1]!.messages)
+    expect(first).toContain('binding revision 1')
+    expect(second).toContain('binding revision 2')
+    expect(second).not.toContain('binding revision 1')
+    expect(second).toContain('memory revision 2')
+    expect(second).toContain('other owner retained')
+    expect(h.agent.session.snapshotEvents().filter(e => e.type === 'user/message' && e.data.source.kind === 'user')).toHaveLength(1)
+    expect(h.agent.session.snapshotEvents().filter(e => e.type === 'step/start')).toHaveLength(1)
+  })
+
+  it('contains refresh failure before provider dispatch and accepted user admission', async () => {
+    const h = await harness()
+    h.agent.ctx.on('agent/prepare-prompt', async () => { throw new Error('refresh failed') })
+    await send(h.agent)
+    expect(h.adapter.requests).toEqual([])
+    expect(h.agent.session.snapshotEvents().some(e => e.type === 'user/message')).toBe(false)
+  })
+
+  it('prevents late publication and dispatch when the owner disposes during refresh', async () => {
+    const h = await harness()
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    let published = false
+    h.agent.ctx.on('agent/prepare-prompt', async ({ signal }) => {
+      entered.resolve(undefined)
+      await release.promise
+      signal.throwIfAborted()
+      h.agent.ctx.systemPrompt.section({ name: 'late', order: 400, text: 'late' })
+      published = true
+    })
+    const running = send(h.agent)
+    await entered.promise
+    const disposing = h.handle.dispose()
+    release.resolve(undefined)
+    await Promise.all([running, disposing])
+    expect(published).toBe(false)
+    expect(h.adapter.requests).toEqual([])
+    expect(h.ctx.agents.get(h.agent.id)).toBeUndefined()
+  })
+
+  it('revalidates model admission after asynchronous route resolution', async () => {
+    const h = await harness()
+    let allowed = true
+    const entered = Promise.withResolvers<undefined>()
+    const release = Promise.withResolvers<undefined>()
+    h.agent.ctx.on('agent/request', async (_payload, next) => {
+      entered.resolve(undefined)
+      await release.promise
+      return next()
+    })
+    h.agent.ctx.on('agent/model-admission', async () => {
+      if (!allowed) throw new Error('execution revoked')
+    })
+    const running = send(h.agent)
+    await entered.promise
+    allowed = false
+    release.resolve(undefined)
+    await running
+    expect(h.adapter.requests).toEqual([])
+    expect(h.agent.session.snapshotEvents().some(e => e.type === 'user/message')).toBe(false)
+  })
+  it('refuses unsupported factories before creating any reserved resource', async () => {
+    const ctx = new Context()
+    contexts.push(ctx)
+    await ctx.plugin(AgentRegistry)
+    let creations = 0
+    ctx.agents.setFactory({
+      createAgent: async () => { creations++; throw new Error('factory effect must not begin') },
+      resume: async () => { creations++; throw new Error('resume effect must not begin') },
+    })
+    const deferExecution = { owner: 'test-owner', recovery: 'explicit' as const }
+    await expect(ctx.agents.create({ sessionId: SessionId('unsupported'), deferExecution })).rejects.toThrow('does not support deferred execution')
+    await expect(ctx.agents.resume({ resumeSessionId: SessionId('unsupported'), deferExecution })).rejects.toThrow('does not support deferred execution')
+    expect(creations).toBe(0)
+    expect(ctx.agents.get(SessionId('unsupported'))).toBeUndefined()
+  })
+
+  it('denies revocation in a later asynchronous admission listener at the synchronous final cutoff', async () => {
+    const h = await harness()
+    let allowed = true
+    h.agent.ctx.agents.guardExecution(h.agent, () => {
+      if (!allowed) throw new Error('execution revoked after async admission')
+      return undefined
+    })
+    h.agent.ctx.on('agent/model-admission', async () => { expect(allowed).toBe(true) })
+    h.agent.ctx.on('agent/model-admission', async () => { await Promise.resolve(); allowed = false })
+    await send(h.agent)
+    expect(h.adapter.requests).toEqual([])
+    expect(h.agent.session.snapshotEvents().some(e => e.type === 'user/message')).toBe(false)
+  })
+
+  it('rechecks synchronously at provider dispatch when a committed request event revokes authority', async () => {
+    const h = await harness()
+    let allowed = true
+    h.agent.ctx.agents.guardExecution(h.agent, () => {
+      if (!allowed) throw new Error('execution revoked before dispatch')
+      return undefined
+    })
+    h.ctx.on('session/event', (session, event) => {
+      if (session === h.agent.session && event.type === 'request/header') allowed = false
+    })
+    await send(h.agent)
+    expect(h.adapter.requests).toEqual([])
+    expect(h.agent.session.snapshotEvents().some(e => e.type === 'request/header')).toBe(true)
+  })
+
+  it('removes only disposed policy effects while retaining other owners', async () => {
+    const h = await harness([textResponse('one'), textResponse('two')])
+    let first = 0
+    let second = 0
+    const owner = await h.agent.ctx.plugin(function policy(ctx) {
+      ctx.agents.guardExecution(h.agent, () => { first++; return undefined })
+    })
+    h.agent.ctx.agents.guardExecution(h.agent, () => { second++; return undefined })
+    await send(h.agent)
+    expect(first).toBe(2)
+    expect(second).toBe(2)
+    await owner.dispose()
+    await send(h.agent)
+    expect(first).toBe(2)
+    expect(second).toBe(4)
+    expect(h.adapter.requests).toHaveLength(2)
+  })
+
+})
