--- /dev/null
+++ b/scripts/fixtures/sdk-request-refresh.mjs
@@ -0,0 +1,27 @@
+/** Await and publish one current prompt contribution for each actual SDK model request. */
+export const name = 'sdk-request-refresh'
+export const inject = ['systemPrompt', 'llm']
+
+/** @param {import('@deepseek-ai/cordis').Context} ctx - Composed runtime services. */
+export function apply(ctx) {
+  let version = 0
+  ctx.effect(() => ctx.systemPrompt.section({
+    name: 'sdk:request-refresh',
+    order: 400,
+    text: () => `SDK request refresh version ${version}.`,
+  }))
+  ctx.on('agent/prepare-prompt', async ({ signal }) => {
+    await Promise.resolve()
+    signal.throwIfAborted()
+    version += 1
+  })
+  ctx.on('llm/stream', (request, next) => {
+    const prompts = request.messages.filter(message => message.role === 'system')
+      .map(message => JSON.stringify(message.content))
+    if (prompts.length !== version || prompts.some((text, index) =>
+      !text.includes(`SDK request refresh version ${index + 1}.`))) {
+      throw new Error('SDK request dispatched before awaited prompt refresh')
+    }
+    return next()
+  })
+}
