+    } else if (data.kind === 'aborted') {
+      if (result.state === 'activated' || result.state === 'aborted') throw new SubagentError('invalid cancellation edge', 'CONTINUABLE_STATE_CONFLICT')
+      result.state = 'aborted'
+    } else {
+      throw new SubagentError('invalid initial admission kind', 'CONTINUABLE_STATE_CONFLICT')
+    }
+  }
