+import type { Activation, ContinuableActivationRegistry } from './continuation-activation.ts'
+import { SubagentError } from './error.ts'
+
+/** Persisted child-owned admission facts; quarantined content has no surface operation. */
+type InitialAdmission =
+  | { version: 1; kind: 'persisted'; key: string; digest: string; message: UserMessage }
+  | { version: 1; kind: 'activated' | 'aborted' }
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Versioned quarantined initial item, release, or cancellation tombstone. */
+    'subagent/initial-admission': InitialAdmission
+  }
+}
+
+/** Owner-visible state of a reserved child generation. */
+export type ContinuableState = 'materialized' | 'inbox-persisted' | 'activated' | 'aborted' | 'disposed'
+
+/** Opaque capability returned only to the exact child lifecycle owner. */
+export interface ReservedContinuable {
+  readonly childId: SessionId
+  readonly agent: Agent
+  readonly memberScope: Context
+  readonly state: ContinuableState
+  readonly initialMessageId: MessageId | undefined
+  /** Flush one quarantined initial item without waking execution.
+   * @param content - initial user content.
+   * @param idempotencyKey - exact durable admission identity.
+   * @param signal - caller cancellation before completion.
+   * @returns original initial message identity.
+   */
+  persistInitialPrompt(content: ContentBlock[], idempotencyKey: string, signal: AbortSignal): Promise<MessageId>
+  /** Release existing input after the owner durably commits readiness.
+   * @param signal - caller cancellation before release.
+   * @returns completion of durable release and execution opening.
+   */
+  activate(signal: AbortSignal): Promise<void>
+  /** Flush a tombstone before stopping and releasing this generation.
+   * @param signal - caller cleanup deadline.
+   * @returns completion after tombstone persistence and teardown.
+   */
+  abort(signal: AbortSignal): Promise<void>
+  /** Release runtime ownership while preserving durable recovery facts.
+   * @param signal - optional total cleanup deadline; late teardown remains observed.
+   * @returns shared cleanup outcome, including failure, or caller cancellation at the deadline.
+   */
+  dispose(signal?: AbortSignal): Promise<void>
+}
+
+/** Own-suffix durable admission state. */
+export interface AdmissionState {
+  state: Exclude<ContinuableState, 'disposed'>
+  initial?: Extract<InitialAdmission, { kind: 'persisted' }>
+  initialCommitted?: boolean
+}
+
+/** Canonical content identity, independent of object property insertion order. */
+function contentDigest(content: ContentBlock[]): string {
+  const canonical = (value: unknown): unknown => {
+    if (Array.isArray(value)) return value.map(canonical)
+    if (value !== null && typeof value === 'object') {
+      return Object.fromEntries(Object.entries(value).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
+        .map(([key, entry]) => [key, canonical(entry)]))
+    }
+    return value
+  }
+  return createHash('sha256').update(JSON.stringify(canonical(content))).digest('hex')
+}
+
+/** Validate and fold versioned admission facts from the child's own log suffix.
+ * @param events - own child events, excluding inherited lineage.
+ * @returns durable initial item and its release/cancellation state.
+ */
+export function foldInitialAdmission(events: readonly SessionEvent[]): AdmissionState {
+  const result: AdmissionState = { state: 'materialized' }
+  for (const event of events) {
+    if (event.type !== 'subagent/initial-admission') continue
+    // The event payload crosses durable storage; validate required fields at runtime.
+    const payload: unknown = event.data
+    if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) {
+      throw new SubagentError('initial admission payload must be a record', 'CONTINUABLE_STATE_CONFLICT')
+    }
+    const data = payload as { version: unknown; kind: unknown; key: unknown; digest: unknown; message?: UserMessage }
