diff --git a/packages/experimental/gat-core/src/error.ts b/packages/experimental/gat-core/src/error.ts
new file mode 100644
index 0000000000..e0b89b72bd
--- /dev/null
+++ b/packages/experimental/gat-core/src/error.ts
@@ -0,0 +1,23 @@
+/** Typed Agent Teams failures. */
+
+import { inspect } from 'node:util'
+import { HarnessError } from '@deepseek-ai/dsh-llm'
+
+/** Stable failure raised by the Team domain. */
+export class TeamError extends HarnessError {
+  constructor(message: string, code: string, options?: ErrorOptions) {
+    super(message, code, options)
+    this.name = 'TeamError'
+  }
+}
+
