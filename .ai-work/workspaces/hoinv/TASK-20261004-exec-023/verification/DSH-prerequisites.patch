+        await flush()
+        assertOpen()
+        signal.throwIfAborted()
+        if (activation.handle.releaseExecution === undefined) throw new Error('Agent factory lacks reserved execution support')
+        activation.handle.releaseExecution()
+        activation.announced = true
+        opened = true
+        registry.releaseReservation(activation)
+      } catch (cause: unknown) {
+        if (signal.aborted) throw cause
+        throw new SubagentError('continuable activation failed', 'CONTINUABLE_ACTIVATE_FAILED', { cause })
+      }
+    }),
+    abort: (signal: AbortSignal) => {
+      if (disposed || activation.inbox.closing !== undefined) {
+        return Promise.reject(new SubagentError('continuable reservation is closed', 'CONTINUABLE_CLOSED'))
+      }
+      if (admission.state === 'activated') {
+        return Promise.reject(new SubagentError('activated reservation cannot be aborted', 'CONTINUABLE_STATE_CONFLICT'))
+      }
+      closing = true
+      activation.handle.closeExecution?.()
+      return bounded(registry.locks.run(child.id, async () => {
+        if (disposed) throw new SubagentError('continuable reservation is closed', 'CONTINUABLE_CLOSED')
+        if (admission.state === 'activated') throw new SubagentError('activated reservation cannot be aborted', 'CONTINUABLE_STATE_CONFLICT')
+        if (admission.state !== 'aborted') {
+          assertOpen(true)
+          child.session.append('subagent/initial-admission', { version: 1, kind: 'aborted' })
+          admission.state = 'aborted'
+        }
+        // Tombstone persistence precedes release even when the cleanup deadline expires.
+        await flush()
+        disposed = true
+        await registry.dispose(activation)
+      }), signal)
+    },
+    dispose: (signal?: AbortSignal) => {
+      if (disposal === undefined) {
+        closing = true
+        activation.handle.closeExecution?.()
+        disposal = registry.locks.run(child.id, async () => {
+          disposed = true
+          await registry.dispose(activation)
+        })
+      }
+      return bounded(disposal, signal)
+    },
+  })
+}
