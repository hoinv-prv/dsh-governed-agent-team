{"id":"CAP-001-04","type":"finding_candidate","title":"Standalone GAT source lags installed DSH experimental GAT","content":"The DSH checkout contains simpleMode, bounded team_members.yaml loading, route preflight and Agent route support, while the standalone GAT source still uses a built-in-only initializer. Feature implementation should close this baseline drift before adding member binding.","status":"captured","discovered_at":"2026-09-26","candidate_kind":"spec_impl_drift","suggested_target":"wiki_reference","improvement_scope":"project","reusable":true,"source_refs":["docs/GAT_DESIGN_AND_FEATURE_REFERENCE.md","packages/tools/src/index.ts","/home/hoinv/deepseek-harness/packages/experimental/gat-tools/src/index.ts","/home/hoinv/deepseek-harness/packages/experimental/gat-tools/src/team-config.ts"]}
